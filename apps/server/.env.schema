# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Origin browsers may call the API from; `*` allows any. API keys travel in a header, not cookies,
# so `*` exposes nothing a direct request could not already reach.
# @type=string(minLength=1)
CORS_ORIGIN=*

# @type=string(minLength=1)
DATABASE_URL=file:../../.data/buncrawl.db

# @type=string(minLength=1)
BUNCRAWL_ARTIFACTS_PATH=../../.data/artifacts

# @required=false @type=url
BUNCRAWL_R2_ENDPOINT=

# @required=false @type=string(minLength=1)
BUNCRAWL_R2_BUCKET=

# @required=false @type=string(minLength=1)
BUNCRAWL_R2_ACCESS_KEY_ID=

# @required=false @type=string(minLength=1)
BUNCRAWL_R2_SECRET_ACCESS_KEY=

# @required=false @type=string(minLength=1)
BUNCRAWL_R2_REGION=

# Redis for instant job wakeups across server processes; workers poll the database without it.
# @required=false @type=url
REDIS_URL=

# @required=false @type=url
BUNCRAWL_PROXY_URL=

# API key(s) clients send as `Authorization: Bearer <key>`; separate several with commas to rotate
# keys. Unset, the API accepts requests from anyone who can reach it.
# @required=false @type=string(minLength=16)
BUNCRAWL_API_KEY=

# Signs webhooks for Firecrawl v2 requests, which carry no per-request secret.
# @required=false @type=string(minLength=16)
BUNCRAWL_WEBHOOK_SECRET=

# Chrome or Chromium executable for Bun.WebView; defaults to the first one on PATH.
# Browser settings are not secret: GET /v1/capabilities reports the resolved paths.
# @required=false @sensitive=false @type=string(minLength=1)
BUN_CHROME_PATH=

# Lightpanda executable; defaults to `lightpanda` on PATH.
# @required=false @sensitive=false @type=string(minLength=1)
BUNCRAWL_LIGHTPANDA_PATH=

# Launch Chrome with --no-sandbox, for containers that deny the user namespaces its sandbox needs.
# @required=false @sensitive=false @type=boolean
BUNCRAWL_CHROME_NO_SANDBOX=
