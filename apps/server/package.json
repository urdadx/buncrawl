{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "imports": {
    "#env": {
      "buncrawl-executable": "./src/env.executable.ts",
      "default": "./src/env.server.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --minify --sourcemap --bytecode --format=esm --conditions=buncrawl-executable ./src/executable.ts ./src/extract-worker.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@buncrawl/api": "workspace:*",
    "@buncrawl/artifacts": "workspace:*",
    "@buncrawl/contracts": "workspace:*",
    "@buncrawl/crawl": "workspace:*",
    "@buncrawl/db": "workspace:*",
    "@buncrawl/jobs": "workspace:*",
    "@buncrawl/renderer": "workspace:*",
    "@buncrawl/scrape": "workspace:*",
    "@buncrawl/security": "workspace:*",
    "@trpc/server": "catalog:",
    "libsql": "catalog:",
    "valibot": "catalog:",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@buncrawl/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
